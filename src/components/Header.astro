---
---

<header>
	<nav>
		<a href="/" class="nav-logo">crafted<span>bycode</span></a>
		<div class="nav-links">
			<a href="/#services">Services</a>
			<a href="/about/">About</a>
			<a href="/blog/">Blog</a>
			<a href="/#contact" class="nav-cta">Let's talk</a>
		</div>
		<button
			class="hamburger"
			id="hamburger"
			aria-label="Open menu"
			aria-expanded="false"
		>
			<span></span><span></span><span></span>
		</button>
	</nav>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
	<a href="/#services">Services</a>
	<a href="/about/">About</a>
	<a href="/blog/">Blog</a>
	<a href="/#contact" class="mobile-cta">Let's talk</a>
</div>

<script>
	const btn = document.getElementById('hamburger')!;
	const menu = document.getElementById('mobileMenu')!;
	btn.addEventListener('click', () => {
		const open = menu.classList.toggle('open');
		btn.classList.toggle('open', open);
		btn.setAttribute('aria-expanded', String(open));
		menu.setAttribute('aria-hidden', String(!open));
	});
</script>

<style>
	header {
		position: sticky; top: 0; z-index: 100;
		background: rgba(13,17,23,0.95);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(45,212,191,0.1);
		margin: 0; padding: 0;
		box-shadow: none;
	}
	nav {
		display: flex; align-items: center; justify-content: space-between;
		padding: 1.25rem 3rem;
		flex-direction: row; gap: 0;
	}
	.nav-logo {
		font-weight: 800; font-size: 1rem; letter-spacing: -0.02em;
		color: #f0fdfa; text-decoration: none; border-bottom: none;
	}
	.nav-logo:hover { color: #f0fdfa; }
	.nav-logo span { color: #2dd4bf; }
	.nav-links { display: flex; gap: 2rem; align-items: center; }
	.nav-links a {
		color: #94a3b8; text-decoration: none; font-size: 0.875rem;
		font-weight: 500; padding: 0; border-bottom: none;
	}
	.nav-links a:hover { color: #f0fdfa; }
	.nav-links a.nav-cta {
		background: linear-gradient(90deg, #2dd4bf, #0f9f8a);
		color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,0.25);
		padding: 0.45rem 1.1rem; border-radius: 6px;
		font-weight: 700; font-size: 0.8rem;
	}
	.nav-links a.nav-cta:hover { color: #fff; }

	.hamburger {
		display: none; flex-direction: column; gap: 5px;
		cursor: pointer; padding: 4px; background: none; border: none;
	}
	.hamburger span {
		display: block; width: 22px; height: 2px;
		background: #f0fdfa; border-radius: 2px;
		transition: transform 0.25s, opacity 0.25s;
	}
	.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
	.hamburger.open span:nth-child(2) { opacity: 0; }
	.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

	.mobile-menu {
		display: none; flex-direction: column;
		background: #0d1117;
		border-bottom: 1px solid rgba(45,212,191,0.1);
		position: sticky; top: 64px; z-index: 99;
	}
	.mobile-menu a {
		color: #94a3b8; text-decoration: none;
		font-size: 1rem; font-weight: 500;
		padding: 1rem 2rem;
		border-bottom: 1px solid rgba(255,255,255,0.05);
	}
	.mobile-menu .mobile-cta {
		margin: 1rem 2rem 1.25rem;
		background: linear-gradient(90deg, #2dd4bf, #0f9f8a);
		color: #fff; font-weight: 700; font-size: 0.9rem;
		padding: 0.7rem 1.5rem; border-radius: 8px;
		text-align: center; border-bottom: none;
	}
	.mobile-menu.open { display: flex; }

	@media (max-width: 640px) {
		nav { padding: 1rem 1.5rem; }
		.nav-links { display: none; }
		.hamburger { display: flex; }
	}
</style>
